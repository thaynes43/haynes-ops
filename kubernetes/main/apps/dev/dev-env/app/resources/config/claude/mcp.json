{
  "mcpServers": {
    "home-assistant": {
      "type": "http",
      "url": "http://ha-mcp.home-automation.svc.cluster.local:8086${HA_MCP_SECRET_PATH}"
    },
    "grafana-mcp": {
      "type": "http",
      "url": "http://mcp-grafana.observability.svc.cluster.local:8000/mcp"
    },
    "mcp-unifi": {
      "type": "sse",
      "url": "http://mcp-unifi.observability.svc.cluster.local:3000/sse"
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--browser",
        "chromium",
        "--headless"
      ]
    },
    "outline": {
      "command": "uvx",
      "args": [
        "mcp-outline"
      ],
      "env": {
        "OUTLINE_API_KEY": "${OUTLINE_API_KEY}",
        "OUTLINE_API_URL": "https://wiki.sigoalumni.org/api"
      }
    },
    "vexa": {
      "type": "http",
      "url": "http://vexa-vexa-gateway.ai.svc.cluster.local:8000/mcp",
      "headers": {
        "X-API-Key": "${VEXA_API_KEY}"
      }
    },
    "cigar-journal": {
      "type": "http",
      "url": "https://cigars.haynesnetwork.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CIGAR_JOURNAL_TOKEN}"
      }
    }
  }
}
