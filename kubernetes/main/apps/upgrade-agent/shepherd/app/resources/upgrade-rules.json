  "own_image_pin_wait": {
    "applies_to": "own_images with cluster_effect delayed and pin_automerge true",
    "waits_for": "renovate-pin-after-next-push-to-main",
    "text": "A source merge changes the cluster only when Renovate's next hosted run opens the digest pin PR and auto-merges it, and Flux applies it at its next poll. Renovate's runs follow pushes to main, so after a source merge late in a quiet night the rebuilt image can stay unpinned until the next push.",
    "verified_when": "the main build for the merge is green, the pin PR for the new digest has merged, Flux applied it and the workload soaked on the new digest",
    "observed_20261110": [
      "upgrade-shepherd and upgrade-agent (#4336): source 07:03:22Z, builds green 07:03Z; Renovate ran 07:07Z before the images were pushed and again only after the next push to main at 07:59Z; pins #4772/#4773 opened 08:00-08:01Z, auto-merged 08:03-08:04Z, applied at the 08:30Z Flux poll (87 minutes source to cluster, 55 of them waiting for Renovate)",
      "audio-authoring (#4753): source 06:00:13Z; pin #4769 opened 06:09Z, auto-merged 06:11:54Z; pod replaced about 06:32Z",
      "actions-runner (#4736, not a Renovate PR): source 06:36:24Z; pin #4770 opened 06:42Z, auto-merged 06:45:16Z; runner pools Ready on 0.1.2 by 07:02Z"
    ],
    "source": "OP513 comments 6326, 6331 and 6350"
  },
  "package_rules": [
    {
      "id": "qbittorrent-allowed-client",
      "match": {
        "packages": [
          "/home-operations/qbittorrent$/"
        ],
        "update_types": [
          "minor",
          "major",
          "digest"
        ]
      },
      "needs": "deterministic",
      "condition": {
        "type": "allowed-client-list",
        "url": "https://www.myanonamouse.net/tor/allowed_clients.php",
        "compare": "the new version is inside the page's \"Allowed Clients: qBittorrent\" line"
      },
      "step1": "recorded only; the Job does not fetch the page (egress for that host comes with the live step)",
      "source": "OP513 comment 6179; autoMerge.json5 qbittorrent carve-out"
    },
    {
      "id": "arr-major-stable",
      "match": {
        "packages": [
          "/home-operations/(sonarr|radarr|prowlarr|lidarr)$/"
        ],
        "update_types": [
          "major"
        ]
      },
      "needs": "deterministic",
      "condition": {
        "type": "upstream-stable-release",
        "repos": {
          "sonarr": "Sonarr/Sonarr",
          "radarr": "Radarr/Radarr",
          "prowlarr": "Prowlarr/Prowlarr",
          "lidarr": "Lidarr/Lidarr"
        },
        "compare": "a GitHub release with prerelease=false exists in the new major"
      },
      "preapproval": "Tom's ruling Q-03 (OP513 comment 6181): upgrade the first night after the maker marks the major stable, after the backup",
      "step1": "recorded only; the major and the hold in holds.json5 keep it lane B owner until the hold is lifted",
      "source": "OP513 comments 6179 and 6181"
    },
    {
      "id": "calibre-epub-convert",
      "match": {
        "packages": [
          "/linuxserver/calibre$/"
        ]
      },
      "needs": "deterministic",
      "condition": {
        "type": "check-success",
        "workflow": "LazyLibrarian EPUB Convert",
        "check": "LazyLibrarian EPUB Convert - Success"
      },
      "source": "autoMerge.json5 calibre carve-out"
    },
    {
      "id": "lazylibrarian-patched-files",
