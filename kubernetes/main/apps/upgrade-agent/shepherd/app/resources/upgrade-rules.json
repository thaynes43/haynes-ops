          "/thaynes43/comfyui$/"
        ]
      },
      "needs": "agent",
      "reason": "a render check on the exact image; a restart is a cold model load",
      "source": "autoMerge.json5 comfyui carve-out"
    },
    {
      "id": "comfyui-image-tag",
      "match": {
        "paths": [
          "scripts/comfyui/Dockerfile"
        ],
        "packages": [
          "/comfy/i"
        ]
      },
