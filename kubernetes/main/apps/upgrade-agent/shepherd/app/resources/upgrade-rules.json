  "own_images": [
    {
      "id": "upgrade-shepherd",
      "image": "ghcr.io/thaynes43/upgrade-shepherd",
      "source_globs": [
        "scripts/upgrade-shepherd/**"
      ],
      "build": ".github/workflows/upgrade-shepherd-build.yml",
      "pin_follows": "digest",
      "pin_automerge": true,
      "cluster_effect": "delayed",
      "pins": [
        "kubernetes/main/apps/upgrade-agent/shepherd/app/helmrelease.yaml",
        "kubernetes/main/apps/upgrade-agent/alert-responder/app/helmrelease.yaml"
      ],
      "note": "main build re-pushes 0.1.0; Renovate auto-merges the digest pin (seen 2026-11-09). Excluded from both lanes as a merger-own path."
    },
    {
      "id": "upgrade-agent",
      "image": "ghcr.io/thaynes43/upgrade-agent",
      "source_globs": [
        "scripts/upgrade-agent/Dockerfile"
      ],
      "build": ".github/workflows/upgrade-agent-build.yml",
      "pin_follows": "digest",
      "pin_automerge": true,
      "cluster_effect": "delayed",
      "pins": [
        "kubernetes/main/apps/upgrade-agent/health-gate/app/helmrelease.yaml"
      ],
      "note": "the Dockerfile has no PR build. Excluded from both lanes as a merger-own path."
    },
    {
      "id": "audio-authoring",
      "image": "ghcr.io/thaynes43/audio-authoring",
      "source_globs": [
        "scripts/audio-authoring/**"
      ],
