{
  "schema": "haynes.upgrade-rules/v1",
  "doc": ".agents/runbooks/upgrade-night-lane.md. Design: OP512 comment 6193 (https://work.haynesnetwork.com/projects/haynes-engineering/work_packages/512). Read by lane-classify.mjs; scripts/upgrade-agent/lane-classify-selftest.mjs checks it against .github/workflows, .renovate and the pins.",
  "renovate_pr_authors": [
    "app/renovate",
    "renovate",
    "renovate[bot]"
  ],
  "renovate_commit_authors": [
    "renovate[bot]"
  ],
  "trusted_vet_authors": [
    "haynes-ops-bot[bot]"
  ],
  "check_max_age_days": 7,
  "strictness": [
    "EXCLUDED",
    "LANE-B-OWNER",
    "LANE-B-AGENT",
    "BLOCKED",
    "LANE-A"
  ],
  "path_classes": [
    {
      "id": "dev-env-v2",
      "globs": [
        "kubernetes/main/apps/dev-env-system/**"
      ],
      "lane": "EXCLUDED",
      "class": "v2-coordinator",
      "reason": "dev-env v2 area, owned by the v2 coordinator"
    },
    {
      "id": "merger-own-paths",
      "globs": [
        "kubernetes/main/apps/upgrade-agent/**",
        "scripts/upgrade-shepherd/**",
        "scripts/upgrade-agent/**"
      ],
      "lane": "EXCLUDED",
      "class": "merger-own-path",
      "reason": "the merger's own code, image or pins"
    },
    {
      "id": "workflow-files",
      "globs": [
        ".github/workflows/**"
      ],
      "lane": "EXCLUDED",
      "class": "workflow-file",
      "reason": "GitHub workflow file"
    },
    {
      "id": "renovate-config",
      "globs": [
        ".renovate/**",
        ".github/renovate.json5"
      ],
      "lane": "EXCLUDED",
      "class": "renovate-config",
      "reason": "Renovate configuration"
    },
    {
      "id": "v1-restart",
      "globs": [
        "kubernetes/main/apps/dev/dev-env/**",
        "kubernetes/main/apps/upgrade-agent/dev-env-ops/**"
      ],
      "lane": "LANE-B-OWNER",
      "class": "v1-restart",
      "reason": "restarts the v1 dev-env pod or dev-env-ops and their sessions; Tom picks the night"
    }
  ],
  "check_map": {
    "always": [
      {
        "workflow": "Diff Scope",
        "check": "Diff Scope - Success",
        "source": ".github/workflows/diff-scope.yml",
        "required": true
      },
      {
        "workflow": "Flux Local",
        "check": "Flux Local - Success",
        "source": ".github/workflows/flux-local.yaml",
        "required": true
      }
    ],
    "advisory": [
      {
        "workflow": "Claude Code Review",
        "check": "Claude Review (advisory)",
        "source": ".github/workflows/claude-code-review.yml"
      }
    ],
    "entries": [
      {
        "id": "flux-local-kubernetes",
        "source": ".github/workflows/flux-local.yaml",
        "workflow": "Flux Local",
        "filter": "job",
        "paths": [
          "kubernetes/**/*"
        ],
        "checks": [
          "Flux Local - Test (main)",
          "Flux Local - Diff (main/helmrelease)",
          "Flux Local - Diff (main/kustomization)"
        ],
        "note": "job-level filter (bjw-s-labs/action-changed-files kubernetes/**/*). When nothing under kubernetes/ changes these legs report SKIPPED under the unexpanded name, so a kubernetes/** PR must show all three SUCCESS by their expanded names."
      },
      {
        "id": "flux-local-portal-oidc",
        "source": ".github/workflows/flux-local.yaml",
        "workflow": "Flux Local",
        "filter": "job",
        "paths": [
          "kubernetes/main/apps/network/authentik/**",
          "scripts/tests/portal178-m5a/**",
          ".agents/reports/portal178-m5a/pending/**",
          ".github/workflows/flux-local.yaml"
        ],
        "checks": [
          "Flux Local - Portal OIDC guard"
        ]
      },
      {
        "id": "audio-authoring-build",
        "source": ".github/workflows/audio-authoring-build.yml",
        "workflow": "Build and Push Audio Authoring Image",
        "filter": "on.pull_request.paths",
        "paths": [
