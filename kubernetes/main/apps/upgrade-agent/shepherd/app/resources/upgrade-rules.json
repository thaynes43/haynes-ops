    "no_pr_validation": {
      "rule": "A changed path outside kubernetes/ that no entry above matches has no PR-triggered validation (Diff Scope and Flux Local - Success pass trivially for it). Such a PR is never lane A.",
      "known_examples": [
        "docs/requirements.txt (publishmkdocs runs only on push to main)",
        "scripts/upgrade-agent/Dockerfile (upgrade-agent-build runs only on push)"
      ]
    },
    "no_pr_trigger": [
      ".github/workflows/claude.yml",
      ".github/workflows/pr-disposition.yml",
      ".github/workflows/publishmkdocs.yml",
      ".github/workflows/repair-image-signatures.yml"
    ]
