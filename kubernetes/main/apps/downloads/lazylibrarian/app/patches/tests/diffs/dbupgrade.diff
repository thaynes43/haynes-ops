+            unlinked = db.match('SELECT count(*) AS n FROM books b WHERE NOT EXISTS '
+                                '(SELECT 1 FROM bookauthors ba WHERE ba.BookID = b.BookID)')
+            unlinked = check_int(unlinked['n'], 0) if unlinked else 0
+            if unlinked:
