+        extra = ' '.join(w for w in extra.split() if w not in _EDITION_WORDS)
+        if not extra or own == volume or fuzz.token_set_ratio(' '.join(wanted), extra) >= OTHER_TITLE_RATIO:
+            return None
+    return volume, other
