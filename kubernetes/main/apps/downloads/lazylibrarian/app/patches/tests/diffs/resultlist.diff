+VOLUME_PENALTY = 50
+OTHER_TITLE_RATIO = 90
+_NOT_A_TITLE = {'retail', 'ebook', 'audiobook', 'epub', 'mobi', 'azw3', 'azw', 'pdf', 'mp3', 'm4b', 'm4a', 'flac',
