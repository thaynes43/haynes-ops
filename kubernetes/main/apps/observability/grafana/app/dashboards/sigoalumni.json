    {
      "id": 2,
      "type": "stat",
      "title": "Uptime — last 1h",
      "description": "Gatus success ratio over the trailing 1h, per check. external = WAN-path /api/healthz (DB-truthful, key external_sigoalumni); internal = in-cluster GET / (key internal_sigoalumni). Ratio = successful results / total results (increase of gatus_results_total). A brand-new check only has data since it was deployed, so wide windows read the partial window honestly rather than back-filling.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (key) (increase(gatus_results_total{key=~\"external_sigoalumni|internal_sigoalumni\", success=\"true\"}[1h])) / clamp_min(sum by (key) (increase(gatus_results_total{key=~\"external_sigoalumni|internal_sigoalumni\"}[1h])), 1) * 100",
          "legendFormat": "{{key}}",
          "refId": "A"
        }
      ]
    },
