  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["media", "storage", "exportarr", "plan-013"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Media Storage — Utilization & Free Space",
  "uid": "media-storage-utilization",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Current Free Space",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Free Space — per root folder",
      "description": "Current free space reported by each *arr root folder (exportarr freeSpace). HaynesTower (Movies + TV) shares one ~530 TB NFS array; the owner's target is < 80% used, i.e. a ~106 TB free floor (red below). Music is a separate ~175 TB CephFS pool with no target set. exportarr exposes freeSpace only — there is no total series in Prometheus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 105990000000000 }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "radarr_rootfolder_freespace_bytes",
          "legendFormat": "{{path}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sonarr_rootfolder_freespace_bytes",
          "legendFormat": "{{path}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "lidarr_rootfolder_freespace_bytes",
          "legendFormat": "{{path}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Trend & Utilization",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Free Space Over Time — per root folder",
      "description": "Free space over time per *arr root folder (exportarr *_rootfolder_freespace_bytes — freeSpace only; exportarr carries no total). The red threshold line at ~106 TB is the STATIC current HaynesTower target: 80% used of the 529.96 TB shared NFS array = a 20%-free floor (105990000000000 bytes). HaynesTower = Movies + TV on that one array, so the radarr and sonarr series track together. Music (lidarr / CephFS) is a separate ~175 TB pool with NO target set. Targets themselves live in the app's app_settings, not Prometheus — update this line if the target or array size changes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "min": 0,
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 105990000000000 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "asc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "radarr_rootfolder_freespace_bytes",
          "legendFormat": "radarr {{path}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sonarr_rootfolder_freespace_bytes",
          "legendFormat": "sonarr {{path}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "lidarr_rootfolder_freespace_bytes",
          "legendFormat": "lidarr {{path}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "HaynesTower % Used",
      "description": "HaynesTower percent used, computed from the Movies-path free space against a baked-in 529.96 TB array total (exportarr carries NO total series, so the total is a hard-coded constant here: 529960000000000 bytes). HaynesTower = Movies + TV on one shared ~530 TB NFS array. Green < 80% used, red >= 80% used (the owner's target). Update the 529.96 TB constant here if the array grows.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 8 },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(1 - radarr_rootfolder_freespace_bytes{path=\"/data/haynestower/Media/Movies\"} / 529960000000000) * 100",
          "legendFormat": "HaynesTower % used",
          "refId": "A"
        }
      ]
    }
  ]
}
