    {
      "id": 11,
      "type": "timeseries",
      "title": "Bearer age vs freshness SLA",
      "description": "How old the minted Peloton bearer is against its 6-hour freshness SLA. The bearer should be refreshed before the age line crosses the SLA line.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
