          "legendFormat": "bearer age",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "ytdrivarr_bearer_sla_seconds{provider=\"peloton\"}",
          "legendFormat": "freshness SLA",
          "refId": "B"
