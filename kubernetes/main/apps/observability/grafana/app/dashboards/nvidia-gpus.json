          "expr": "max by (node) (\n  nvidia_smi_clocks_event_reasons_hw_thermal_slowdown\n  or nvidia_smi_clocks_event_reasons_sw_thermal_slowdown\n  or nvidia_smi_clocks_throttle_reasons_hw_thermal_slowdown\n  or nvidia_smi_clocks_throttle_reasons_sw_thermal_slowdown\n)",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ]
