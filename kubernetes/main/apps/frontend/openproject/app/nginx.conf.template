# Stock NGINX configuration for the OpenProject browser/API gateway, not a custom auth service.
# @@HEADER_SECRET@@ is replaced in ephemeral storage, never committed or logged.
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    proxy_buffers 8 16k;
    proxy_buffer_size 32k;

    # Evaluated lazily at proxy_pass, after auth_request has supplied $op_login.
    # A successful auth response with absent/invalid identity fails closed.
    map $op_login $op_upstream {
        default "http://127.0.0.1:1";
        ~^[A-Za-z0-9._@-]+$ "http://127.0.0.1:8080";
    }
    server {
        listen 0.0.0.0:8081;
        server_name work.haynesnetwork.com;
        location / {
            auth_request /outpost.goauthentik.io/auth/nginx;
            error_page 401 = @signin;
            auth_request_set $auth_cookie $upstream_http_set_cookie;
            auth_request_set $op_login $upstream_http_x_authentik_username;
            add_header Set-Cookie $auth_cookie;
            proxy_pass $op_upstream;
            proxy_set_header Host work.haynesnetwork.com;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host work.haynesnetwork.com;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header X-Authenticated-User "$op_login:@@HEADER_SECRET@@";
            proxy_set_header X-Remote-User "";
            proxy_set_header Remote-User "";
            proxy_set_header X-authentik-username "";
            proxy_set_header X-authentik-uid "";
            proxy_set_header Authorization "";
        }
        location /outpost.goauthentik.io {
            proxy_pass http://ak-outpost-openproject-proxy.network.svc.cluster.local:9000;
            proxy_set_header Host work.haynesnetwork.com;
            proxy_set_header X-Original-URL https://work.haynesnetwork.com$request_uri;
            proxy_set_header X-Authenticated-User "";
            proxy_set_header X-Remote-User "";
            proxy_set_header X-authentik-username "";
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
        }
        location @signin {
            internal;
            add_header Set-Cookie $auth_cookie;
            return 302 https://work.haynesnetwork.com/outpost.goauthentik.io/start?rd=https://work.haynesnetwork.com$request_uri;
        }
    }
    server {
        listen 0.0.0.0:8082;
        server_name openproject-api.internal;
        location /api/v3/ {
            if ($http_authorization !~ "^Bearer ") { return 401; }
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host work.haynesnetwork.com;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host work.haynesnetwork.com;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header X-Authenticated-User "";
            proxy_set_header X-Remote-User "";
            proxy_set_header Remote-User "";
            proxy_set_header X-authentik-username "";
            proxy_set_header X-authentik-uid "";
        }
        location / { return 404; }
    }
    # Private portal reader. TLS ends in this Pod. The upstream is loopback only.
    server {
        listen 8443 ssl;
        server_name openproject-web.frontend.svc.cluster.local;
        ssl_certificate /etc/openproject-portal-api-tls/tls.crt;
        ssl_certificate_key /etc/openproject-portal-api-tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location = /api/v3/projects/3/work_packages {
            if ($request_method != GET) { return 405; }
            if ($http_authorization !~ "^Bearer [A-Za-z0-9._~+/-]+=*$") { return 401; }
            # offset is the page number, starting at 1. pageSize stays 50.
            # The only admitted filter is an empty array, percent-encoded as filters=%5B%5D.
            # The previously approved query without that parameter stays admitted.
            if ($args !~ "^offset=[1-9][0-9]{0,4}&pageSize=50(&filters=%5B%5D)?$") { return 400; }
            proxy_pass http://127.0.0.1:8080;
            # The application hostname stays canonical. The dial is loopback only.
            proxy_set_header Host work.haynesnetwork.com;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header X-Authenticated-User "";
            proxy_set_header X-Remote-User "";
            proxy_set_header Remote-User "";
            proxy_set_header X-authentik-username "";
            proxy_set_header X-authentik-uid "";
            proxy_set_header X-Forwarded-User "";
            proxy_set_header X-Auth-Request-User "";
        }
        location / { return 404; }
    }
}
