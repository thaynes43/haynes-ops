# Header-injecting hop: Home Assistant -> cigar-journal MCP server.
# The "why" lives in ../helmrelease.yaml; the short version is that HA's `mcp`
# integration can neither carry a static bearer token nor complete PKCE, so
# nginx supplies the Authorization header the MCP app requires.
#
# ENVSUBST: the container entrypoint renders this file into
# /etc/nginx/conf.d/default.conf. NGINX_ENVSUBST_FILTER pins the substitution to
# CIGAR_JOURNAL_TOKEN alone, so nginx's own $variables ($http_accept, ...) pass
# through untouched. Keep that filter in sync if a second ${...} is ever added.
#
# DNS: proxy_pass with a literal hostname resolves ONCE, at config load. A
# Service ClusterIP is stable for the Service's lifetime, so that is fine here --
# but if cigar-journal-mcp is ever deleted and recreated, restart this pod.

server {
    listen 8080;
    server_name _;

    # Probes only. Never touches the upstream, so a cigar-journal outage does not
    # restart this pod.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Nothing outside /mcp is proxied on purpose: this listener speaks for a
    # full-scope service token, so its reachable surface stays exactly the MCP
    # endpoint. Any other path gets nginx's own 404 and never leaves the pod.
    location /mcp {
        proxy_pass http://cigar-journal-mcp.frontend.svc.cluster.local:8081/mcp;
        proxy_http_version 1.1;

        # The entire point of this app. Overrides whatever the client sent.
        proxy_set_header Authorization "Bearer ${CIGAR_JOURNAL_TOKEN}";
        proxy_set_header Host cigar-journal-mcp.frontend.svc.cluster.local;
        proxy_set_header Accept $http_accept;
        # Clear the hop-by-hop Connection header so keepalive to the upstream is
        # not torn down after every response.
        proxy_set_header Connection "";

        # Streamable HTTP / SSE: Mcp-Session-Id and mcp-protocol-version must
        # survive in both directions (they do -- nginx forwards request headers by
        # default and never strips response headers), and responses must not be
        # buffered or the event stream stalls.
        proxy_pass_request_headers on;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
