diff --git a/optimized/tflite/scripts/xnnpack_cache.py b/optimized/tflite/scripts/xnnpack_cache.py
new file mode 100644
index 0000000..1a741bb
--- /dev/null
+++ b/optimized/tflite/scripts/xnnpack_cache.py
@@ -0,0 +1,17 @@
+"""Writable XNNPACK weight-cache paths for immutable model mounts."""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+
+
+CACHE_ROOT = Path("/tmp/audio-xnnpack")
+
+
+def default_weight_cache_path(model_path):
+    """Return a stable, collision-resistant cache path for a resolved model path."""
+    resolved = Path(model_path).resolve(strict=True)
+    path_identity = hashlib.sha256(os.fsencode(resolved)).hexdigest()
+    CACHE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
+    return CACHE_ROOT / f"{resolved.name}-{path_identity}.xnnwc"
