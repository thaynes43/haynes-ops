{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "labels": {
      "issue825.haynesnetwork/phase": "4906044e613f43c5a6a02c8834500b06",
      "app": "issue831-live-byte-baseline-readonly"
    },
    "name": "issue831-live-byte-baseline-1009-02",
    "namespace": "frontend"
  },
  "spec": {
    "activeDeadlineSeconds": 180,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "annotations": {
          "k8tz.io/inject": "false"
        },
        "labels": {
          "issue825.haynesnetwork/phase": "4906044e613f43c5a6a02c8834500b06",
          "app": "issue831-live-byte-baseline-readonly"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "nice",
              "-n",
              "19",
              "python",
              "-B",
              "-c",
              "import os,json,base64,hashlib,sys\nif os.environ.get('COPY_BASELINE_PHASE_READY')!='1':\n print(json.dumps({'type':'prepared-collector-refused','code':'phase_not_authorized','production_writes':0}),flush=True);raise SystemExit(2)\nfiles={'bound_census_collectors.py': '', 'capture-live-byte-baseline.py': ''}\nhashes={'bound_census_collectors.py': 'c22d220cafebf8c18e9b3f2bfe46156be9e3cc13fd8521532dddd12f97877b6d', 'capture-live-byte-baseline.py': '62a46de3ca67e189b7b584d11ea563bf906daaefd7c1cc675a78532954966d6f'}\nfor name,data in files.items():\n raw=base64.b64decode(data,validate=True)\n if hashlib.sha256(raw).hexdigest()!=hashes[name]:raise SystemExit(2)\n fd=os.open('/tmp/'+name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)\n with os.fdopen(fd,'wb') as f:f.write(raw);f.flush();os.fsync(f.fileno())\nos.execv(sys.executable,[sys.executable,'-B','/tmp/'+'capture-live-byte-baseline.py'])\n"
            ],
            "env": [
              {
                "name": "COPY_BASELINE_PHASE_READY",
                "value": "0"
              },
              {
                "name": "COPY_BASELINE_DEADLINE_EPOCH",
                "value": "0"
              },
              {
                "name": "COPY_BASELINE_MODULE_SHA256_JSON",
                "value": "{}"
              },
              {
                "name": "COPY_PHASE_TOKEN",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.labels['issue825.haynesnetwork/phase']"
                  }
                }
              },
              {
                "name": "COPY_JOB_UID",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.labels['batch.kubernetes.io/controller-uid']"
                  }
                }
              },
              {
                "name": "COPY_POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "COPY_NAMESPACE",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.namespace"
                  }
                }
              },
              {
                "name": "COPY_POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "COPY_NODE",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "spec.nodeName"
                  }
                }
              },
              {
                "name": "COPY_NATIVE_BINDING_PATH",
                "value": "/tmp/native-source-binding.json"
              }
            ],
            "image": "ghcr.io/thaynes43/book-copy-writer:sha-04c611e7ccf6d057f5b6b466dc4d52f5bb5672c8@sha256:fe12dd95f77cbdf33f2bd57cbe8ecb752e9d730a7de6b26b329beca474954d5f",
            "imagePullPolicy": "IfNotPresent",
            "name": "census",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/data/cephfs-hdd",
                "name": "books",
                "readOnly": true
              },
              {
                "mountPath": "/tmp",
                "name": "tmp",
                "readOnly": false
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": false,
        "nodeName": "talosw01",
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccount": "default",
        "serviceAccountName": "default",
        "terminationGracePeriodSeconds": 5,
        "volumes": [
          {
            "name": "books",
            "nfs": {
              "path": "/hdd-nfs-repl",
              "server": "gasha01.haynesnetwork"
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "64Mi"
            },
            "name": "tmp"
          }
        ]
      }
    },
    "ttlSecondsAfterFinished": 600
  }
}
