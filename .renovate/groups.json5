{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Flux Group',
      groupName: 'Flux',
      matchDatasources: [
        'docker',
        'github-tags',
      ],
      versioning: 'semver',
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      separateMinorPatch: true,
      matchPackageNames: [
        '/fluxcd/',
      ],
    },
    {
      description: 'Talos Group',
      groupName: 'Talos',
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      separateMinorPatch: true,
      matchPackageNames: [
        '/siderolabs/talosctl/',
        '/siderolabs/installer/',
      ],
    },
    // ── Tier 3: dashboard-approval phase (docs/renovate/README.md → Tier 3) ──
    // The HA pod moves as ONE unit: code-server is a sidecar in the same pod
    // (a bump restarts HA) and ha-mcp must stay compatible with HA. Approval
    // is SYMMETRIC on every member — asymmetric (satellites-only) approval
    // holds the gated deps OUT of the group branch, so the group would ship
    // HA alone and the satellites strand (the scrapped two-layer design).
    // Updates surface as Dependency Dashboard checkboxes; ticking them yields
    // ONE group PR → flux-local diff → manual merge → one pod restart.
    // PROMOTION RULE: when automating later, drop dependencyDashboardApproval
    // from ALL members in the same commit (+ add a schedule). Never asymmetric.
    {
      description: 'Tier 3: Home Assistant pod group — HA + code-server sidecar + ha-mcp companion',
      groupName: 'home-assistant',
      matchFileNames: [
        'kubernetes/main/apps/home-automation/home-assistant/**',
        'kubernetes/main/apps/home-automation/ha-mcp/**',
      ],
      matchPackageNames: [
        '/home-assistant/home-assistant/',
        '/coder/code-server/',
        '/homeassistant-ai/ha-mcp/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      dependencyDashboardApproval: true,
      automerge: false,
    },
    // Z2M has no companions, but an update can broadcast devices while HA
    // misses them on startup (Zigbee entities stuck `unavailable` until HA
    // restarts) — keep it a babysat, dashboard-approved merge. Post-merge:
    // verify Zigbee entities are available; restart HA if not.
    {
      description: 'Tier 3: Zigbee2MQTT — babysat update (HA-restart race)',
      matchFileNames: [
        'kubernetes/main/apps/home-automation/zigbee2mqtt/**',
      ],
      matchPackageNames: [
        '/koenkk/zigbee2mqtt/',
      ],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    // ── Baked-image toolchains (Dockerfile ARG pins) ─────────────────────────
    // These deps only exist because customManagers.json5 grew a Dockerfile ARG
    // manager on 2026-08-29; before that all 25 annotated pins were invisible to
    // Renovate and only ever moved when a human hand-edited them (claude-code sat
    // at 2.1.217 for five weeks, silently serving Opus 4.8 to every `--model opus`
    // session because claude resolves that alias CLIENT-SIDE in the pinned CLI).
    // Grouped so the newly-visible backlog lands as ONE reviewable PR per image
    // instead of ~25 singles, and because a baked toolchain ships as one image
    // anyway.
    //
    // MERGING ONE IS A TWO-STEP, and step 2 is what actually deploys:
    //   1. merge the ARG bump → dev-env-build.yml builds + cosign-signs a new tag
    //   2. re-pin `tag:`/digest in the consuming helmrelease(s) → THAT rolls pods
    // Nothing reaches a running pod on step 1 alone.
    {
      description: 'dev-env image toolchain (Dockerfile ARG pins) — one PR, manual merge',
      groupName: 'dev-env image toolchain',
      matchFileNames: [
        'scripts/dev-env/Dockerfile',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      // Never auto-merge, for the same reason the dev-env IMAGE bump never does
      // (autoMerge.json5): the workhorse is replicas:1 strategy:Recreate and the
      // digest re-pin that follows hard-kills every in-flight agent session. Whoever
      // merges picks the moment. Same pod, same bounce, same rule.
      automerge: false,
    },
    {
      description: 'upgrade-agent/shepherd image toolchains (Dockerfile ARG pins) — one PR, manual merge',
      groupName: 'upgrade-agent image toolchains',
      matchFileNames: [
        'scripts/upgrade-agent/Dockerfile',
        'scripts/upgrade-shepherd/Dockerfile',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      automerge: false,
    },
    {
      description: 'Vendored vexa chart: bump Chart.yaml with every values.yaml image update — Flux (reconcileStrategy ChartVersion) only repackages a git-sourced chart when its version changes, so an un-bumped update merges and silently never deploys (valkey 9, 2026-09-21).',
      matchFileNames: ['kubernetes/main/apps/ai/vexa/chart/**'],
      bumpVersion: 'patch',
    },
    // ── Pinned Python requirement sets: one update PR per file (OP511) ───────
    // Each file below is a fully pinned set that pip installs as a whole, so one
    // package often cannot move alone. With no group, Renovate opened one PR per
    // package: 51 open on 2026-11-09. In ControlFoley's torch 2.5.1+cu121 set, 26 of
    // 39 failed `validate` with "conflicting dependencies"; cursor-mcp's pydantic and
    // pydantic-core fail apart.
    //
    // Grouped by FILE (matchFileNames), never by package name. numpy, scipy, av,
    // pillow, soundfile, mcp and huggingface-hub sit in more than one of these files,
    // and each copy belongs to a different image or pod. Renovate names each update's
    // branch from its own groupSlug and puts updates with the same branch name in one
    // PR, so a package in two files lands in two file PRs. Today such a package shares
    // one cross-file PR (renovate/numpy-2.x).
    //
    // These rules set grouping ONLY: no automerge, labels or allowedVersions, so
    // autoMerge.json5 and holds.json5 decide each update exactly as before. A branch
    // auto-merges only when every update in it does, so the studio-render minor/patch
    // group still auto-merges under the kubernetes/*/apps/ai/** tier. Majors keep
    // Renovate's default separateMajorMinor: a second "(major)" PR per file on
    // renovate/major-<slug>. Folding majors in would turn every studio-render group
    // manual, which would narrow that tier. These rules come after
    // config:recommended's group:monorepos in extends, so they win the groupName (the
    // opentelemetry-python monorepo PR in cursor-mcp joins its file group).
    // One effective change follows from the split, not from policy: studio-render's
    // numpy and scipy minors used to share a PR with ControlFoley, which no tier
    // auto-merges. In their own file group the ai/** tier now applies to them as written.
    // docs/requirements.txt (one package) is left ungrouped on purpose.
    {
      description: 'ControlFoley image Python set: one PR per update type. Its build fails until the torch set is deliberately re-pinned; manual merge (no automerge tier covers scripts/).',
      groupName: 'controlfoley python requirements',
      groupSlug: 'pip-controlfoley',
      matchManagers: ['pip_requirements'],
      matchFileNames: ['scripts/controlfoley/requirements.txt'],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'dev-env v1 cursor-mcp Python set: one PR per update type. Merging it restarts the v1 dev-env pod and its sessions, so the owner merges it as a held draft. Renovate opens it as an ordinary PR; no automerge tier covers dev/dev-env.',
      groupName: 'cursor-mcp python requirements',
      groupSlug: 'pip-cursor-mcp',
      matchManagers: ['pip_requirements'],
      matchFileNames: ['kubernetes/main/apps/dev/dev-env/app/resources/cursor-mcp-requirements.txt'],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'studio-render Python set: one PR per update type. Auto-merge policy is unchanged: the ai/** tier auto-merges the minor/patch group, and majors stay manual.',
      groupName: 'studio-render python requirements',
      groupSlug: 'pip-studio-render',
      matchManagers: ['pip_requirements'],
      matchFileNames: ['kubernetes/main/apps/ai/studio-render/app/requirements.txt'],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'audio-authoring image Python set: one PR per update type; manual merge (no automerge tier covers scripts/). The huggingface-hub <2.0.0 hold in holds.json5 still applies.',
      groupName: 'audio-authoring python requirements',
      groupSlug: 'pip-audio-authoring',
      matchManagers: ['pip_requirements'],
      matchFileNames: ['scripts/audio-authoring/requirements.txt'],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
  ],
}
